# Workspace-specific Slack IDs for the three Agent Kourier releases. Copy to ids.env (gitignored) and fill in.
CHECKOUT_CHANNEL=C0REPLACEME1     # #checkout-alerts
INCIDENTS_CHANNEL=C0REPLACEME2    # #incidents
PAYMENTS_CHANNEL=C0REPLACEME3     # #payments-ops
ALERT_BOT=B0REPLACEME1            # the bot that posts Alertmanager's messages (an incoming webhook's app)
PAGER_BOT=B0REPLACEME2            # the Pager app's bot
PAYMENTS_APPROVERS=S0REPLACEME1   # the user group whose members may approve a payments rollback
